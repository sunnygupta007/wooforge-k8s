# Flask API Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars
JWT_SECRET_KEY=replace-with-another-secure-jwt-secret-key
DATABASE_URL=sqlite:///wooforge.db
PORT=5000

# Kubernetes Configuration
# Options: 'incluster' (when running inside K8s pod) or 'kubeconfig' (for local Kind / VPS K3s)
K8S_AUTH_MODE=kubeconfig
KUBECONFIG_PATH=~/.kube/config

# Base Domain Strategy
# For local Kind testing: 'local.dev' or '127.0.0.1.nip.io'
# For VPS production: 'store.yourdomain.com'
BASE_DOMAIN=local.dev

# Default Ingress Class (nginx for Kind/standard, traefik for K3s)
INGRESS_CLASS=nginx

# Storage Class (standard for Kind, local-path for K3s)
STORAGE_CLASS=standard

# Store Defaults
DEFAULT_MAX_STORES=5
DEFAULT_STORAGE_GB=2
DEFAULT_MEMORY_MB=1024
DEFAULT_CPU_CORES=1.0
